{
  "name": "codelore",
  "displayName": "CodeLore",
  "description": "Turn today’s work into a story worth sharing.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codelore.reflectOnToday",
        "title": "CodeLore: Reflect on Today"
      },
      {
        "command": "codelore.viewLatestReflection",
        "title": "CodeLore: View Latest Reflection"
      },
      {
        "command": "codelore.draftPostFromLatestReflection",
        "title": "CodeLore: Draft Post from Latest Reflection"
      },
      {
        "command": "codelore.copyLatestDraft",
        "title": "CodeLore: Copy Latest Draft"
      },
      {
        "command": "codelore.connectLinkedIn",
        "title": "CodeLore: Connect LinkedIn"
      },
      {
        "command": "codelore.checkLinkedInConnection",
        "title": "CodeLore: Check LinkedIn Connection"
      }
    ],
    "viewsContainers": {
  "activitybar": [
    {
      "id": "codelore",
      "title": "CodeLore",
      "icon": "resources/codelore.svg"
    }
  ]
},
"views": {
  "codelore": [
    {
      "id": "codelore.today",
      "name": "Today"
    }
  ]
}
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.134.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
